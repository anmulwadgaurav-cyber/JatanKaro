{
  "manifest_version": 3,
  "name": "Second Brain Saver",
  "version": "1.0",

  "permissions": ["activeTab", "storage", "scripting"],

  "host_permissions": ["http://localhost:5000/*", "http://localhost:5173/*"],

  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
