# Backend environment variables example
# Copy this file to `.env` and fill values locally (do NOT commit real secrets)

# Server
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/JatanKaro

# Frontend origin (set to your deployed frontend URL)
FRONTEND_URL=https://your-frontend.example.com

# JWT secret
JWT_SECRET=your_jwt_secret_here

# Redis
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Google / OAuth / Email etc
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_USER=your_google_user_email

# OpenAI / Google API keys
OPENAI_API_KEY=your_openai_key
GOOGLE_API_KEY=your_google_api_key
